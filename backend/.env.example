# 이 파일은 템플릿입니다. 실제 값은 backend/.env.local 에 채워넣고 커밋하지 마세요.

# --- Database ---
DATABASE_URL=mysql://user:password@localhost:3306/planlog

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Kakao OAuth (Kakao Developers > 내 애플리케이션) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/auth/kakao/callback

# --- Auth session ---
JWT_SECRET=

# --- Server ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
